# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 临时文件
*.tmp
*.temp
.cache/

# Python（如果以后加打包脚本）
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Node.js（如果以后加 web demo）
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# 本地测试的 .skill 打包文件（仅本地用，发布走 Releases）
*.skill
!releases/*.skill

# 个人测试笔记（贡献者本地草稿，不进仓库）
DRAFT_*.md
NOTES_*.md
TODO_*.md
private_*.md

# 环境变量（如果以后有 API 自动化）
.env
.env.local
.env.*.local
